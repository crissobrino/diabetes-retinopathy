\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces EfficientNet-B0 Stage\,1 training curves (\texttt  {second\_attempt\_tuned}). Train AUC reaches 0.957 at the best val checkpoint ($\star $, epoch\,14) while val AUC peaks at 0.779, revealing a gap of 0.178. This persistent overfitting motivated the switch to DenseNet121 in \texttt  {sixth\_attempt}, which eliminated the gap (public and private AUC both 0.781).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:curves}{{1}{2}{EfficientNet-B0 Stage\,1 training curves (\texttt {second\_attempt\_tuned}). Train AUC reaches 0.957 at the best val checkpoint ($\star $, epoch\,14) while val AUC peaks at 0.779, revealing a gap of 0.178. This persistent overfitting motivated the switch to DenseNet121 in \texttt {sixth\_attempt}, which eliminated the gap (public and private AUC both 0.781)}{figure.1}{}}
